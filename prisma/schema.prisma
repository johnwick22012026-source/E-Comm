generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int                      @id @default(autoincrement())
  email           String                   @unique
  passwordHash    String
  emailVerified   Boolean                  @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  verificationTokens    EmailVerificationToken[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  active       Boolean  @default(true)

  @@index([userId])
}

/// Stores password reset tokens for secure, auditable reset operations
model PasswordResetToken {
  id          Int      @id @default(autoincrement())
  tokenHash   String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  usedAt      DateTime?
  attemptedAt DateTime?
  attempts    Int      @default(0)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String?
  parentId    Int?
  parent      Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToParent")
  subcategories Subcategory[]
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
}

model Subcategory {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  parentId    Int?
  parent      Subcategory?   @relation("SubcategoryChildren", fields: [parentId], references: [id])
  children    Subcategory[]  @relation("SubcategoryChildren")
  products    Product[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([categoryId, slug])
  @@index([slug])
}

enum AttributeDataType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
}

enum InventoryStatus {
  IN_STOCK
  BACKORDER
  PREORDER
  DISCONTINUED
}

enum RelatedProductType {
  ACCESSORY
  ALTERNATIVE
  COMPLEMENTARY
  SIMILAR
}

enum CartItemStatus {
  ACTIVE
  REMOVED
}

model AttributeDefinition {
  id          Int                  @id @default(autoincrement())
  key         String               @unique
  label       String
  dataType    AttributeDataType    @default(TEXT)
  filterable  Boolean              @default(true)
  searchable  Boolean              @default(true)
  products    ProductAttribute[]
  specifications ProductSpecification[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Product {
  id                  Int                      @id @default(autoincrement())
  name                String
  slug                String                   @unique
  description         String?
  sku                 String                   @unique
  categoryId          Int
  category            Category                 @relation(fields: [categoryId], references: [id])
  subcategoryId       Int?
  subcategory         Subcategory?             @relation(fields: [subcategoryId], references: [id])
  brand               String?
  price               Decimal                  @default(0)
  currency            String                   @default("USD")
  listPrice           Decimal                  @default(0)
  salePrice           Decimal?
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  priceUpdatedAt      DateTime                 @default(now())
  stockQuantity       Int                      @default(0)
  availableQuantity   Int                      @default(0)
  reservedQuantity    Int                      @default(0)
  inventoryStatus     InventoryStatus          @default(IN_STOCK)
  availabilityUpdatedAt DateTime               @default(now())
  isAvailable         Boolean                  @default(true)
  isActive            Boolean                  @default(true)
  popularityScore     Float                    @default(0)
  publishedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  attributes          ProductAttribute[]
  images              ProductImage[]
  specifications      ProductSpecification[]
  inventoryLevels     ProductInventoryLevel[]
  ratingAggregate     ProductRatingAggregate?
  relatedProductsFrom ProductRelationship[]     @relation("ProductRelationshipsFrom")
  relatedProductsTo   ProductRelationship[]     @relation("ProductRelationshipsTo")

  @@index([categoryId, isActive, price])
  @@index([categoryId, isActive, createdAt])
  @@index([categoryId, isActive, popularityScore])
  @@index([brand])
  @@index([isActive, price])
  @@index([publishedAt])
  @@index([inventoryStatus])
  @@index([isAvailable, inventoryStatus])
  @@index([availableQuantity])
  @@index([reservedQuantity])
}

model ProductAttribute {
  id           Int                 @id @default(autoincrement())
  productId    Int
  definitionId Int
  value        String
  numericValue Decimal?
  createdAt    DateTime            @default(now())
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition   AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([productId, definitionId])
  @@index([definitionId])
  @@index([value])
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  productId  Int
  url        String
  altText    String?
  focalPoint String?
  provider   String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
}

model ProductSpecification {
  id           Int                 @id @default(autoincrement())
  productId    Int
  definitionId Int
  value        String
  displayName  String?
  groupName    String?
  displayOrder Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([productId, definitionId])
  @@index([productId])
  @@index([definitionId])
}

model ProductInventoryLevel {
  id               Int      @id @default(autoincrement())
  productId        Int
  locationCode     String
  locationName     String?
  quantityOnHand   Int      @default(0)
  quantityReserved Int      @default(0)
  quantityAvailable Int     @default(0)
  isTracked        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locationCode])
  @@index([productId])
  @@index([locationCode])
}

model ProductRatingAggregate {
  productId           Int     @id
  ratingAverage       Decimal @default(0)
  ratingCount         Int     @default(0)
  ratingTotal         Int     @default(0)
  ratingDistribution  Json?
  updatedAt           DateTime @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([ratingAverage])
  @@index([ratingCount])
}

model ProductRelationship {
  id             Int                @id @default(autoincrement())
  fromProductId  Int
  toProductId    Int
  type           RelatedProductType
  createdAt      DateTime           @default(now())

  fromProduct Product @relation("ProductRelationshipsFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct   Product @relation("ProductRelationshipsTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@unique([fromProductId, toProductId, type])
  @@index([fromProductId])
  @@index([toProductId])
}

/// Cart and CartItem models for persistent cart functionality
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  lastInventoryValidationAt DateTime?

  @@index([userId])
}

model CartItem {
  id                        Int             @id @default(autoincrement())
  cartId                    Int
  productId                 Int
  quantity                  Int             @default(1)
  status                    CartItemStatus  @default(ACTIVE)
  removedAt                 DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  lastValidatedAt           DateTime?
  lastKnownAvailableQuantity Int?
  cart                      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product                   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@index([cartId, status])
  @@index([productId, status])
  @@index([cartId, lastValidatedAt])
}
