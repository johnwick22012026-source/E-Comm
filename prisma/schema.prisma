generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
}

enum PaymentStatus {
  DRAFT
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  VOIDED
}

enum PaymentRefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum PaymentStatusHistorySource {
  INTERNAL
  GATEWAY
}

enum SavedCartRestoreStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SavedCartItemRestoreStatus {
  PENDING
  RESTORED
  FAILED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  PENDING
  APPLIED
  EXPIRED
  INVALIDATED
}

enum ShippingEstimateStatus {
  DRAFT
  CONFIRMED
  EXPIRED
}

enum CheckoutSessionStatus {
  DRAFT
  REVIEW
  PENDING_PAYMENT
  COMPLETED
  ABANDONED
}

enum PaymentAttemptStatus {
  PENDING
  AUTHORIZED
  FAILED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

model User {
  id              Int                      @id @default(autoincrement())
  email           String                   @unique
  passwordHash    String
  emailVerified   Boolean                  @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  verificationTokens    EmailVerificationToken[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  savedCartSnapshots    SavedCartSnapshot[]
  couponRedemptions     CouponRedemption[]
  checkoutSessions      CheckoutSession[]
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  active       Boolean  @default(true)

  checkoutSessions CheckoutSession[] @relation("CheckoutSessionShopperSession")

  @@index([userId])
}

model CheckoutSession {
  id        Int                    @id @default(autoincrement())
  status    CheckoutSessionStatus  @default(DRAFT)
  sessionId Int?
  session   Session?               @relation("CheckoutSessionShopperSession", fields: [sessionId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments  Payment[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([userId])
}

model PasswordResetToken {
  id          Int      @id @default(autoincrement())
  tokenHash   String   @unique
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  usedAt      DateTime?
  attemptedAt DateTime?
  attempts    Int      @default(0)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  description String?
  parentId    Int?
  parent      Category?    @relation("CategoryToParent", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToParent")
  subcategories Subcategory[]
  products    Product[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([slug])
}

model Subcategory {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String
  categoryId  Int
  category    Category       @relation(fields: [categoryId], references: [id])
  parentId    Int?
  parent      Subcategory?   @relation("SubcategoryChildren", fields: [parentId], references: [id])
  children    Subcategory[]  @relation("SubcategoryChildren")
  products    Product[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([categoryId, slug])
  @@index([slug])
}

enum AttributeDataType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
}

enum InventoryStatus {
  IN_STOCK
  BACKORDER
  PREORDER
  DISCONTINUED
}

enum RelatedProductType {
  ACCESSORY
  ALTERNATIVE
  COMPLEMENTARY
  SIMILAR
}

enum CartItemStatus {
  ACTIVE
  REMOVED
}

enum SavedCartRestoreStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SavedCartItemRestoreStatus {
  PENDING
  RESTORED
  FAILED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  PENDING
  APPLIED
  EXPIRED
  INVALIDATED
}

enum ShippingEstimateStatus {
  DRAFT
  CONFIRMED
  EXPIRED
}

enum CheckoutSessionStatus {
  DRAFT
  REVIEW
  PENDING_PAYMENT
  COMPLETED
  ABANDONED
}

enum PaymentAttemptStatus {
  PENDING
  AUTHORIZED
  FAILED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

model Order {
  id                          Int                     @id @default(autoincrement())
  referenceId                 String                  @unique
  userId                      Int?
  user                        User?                   @relation(fields: [userId], references: [id])
  status                      OrderStatus             @default(PENDING_PAYMENT)
  paymentReference            String?                 @unique
  paymentGatewayTransactionId String?                 @unique
  paymentConfirmedAt          DateTime?
  paymentFailedAt             DateTime?
  finalizedAt                 DateTime?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  payments                    Payment[]

  @@index([userId])
  @@index([status])
  @@index([paymentReference])
  @@index([paymentGatewayTransactionId])
}

model Product {
  id                  Int                      @id @default(autoincrement())
  name                String
  slug                String                   @unique
  description         String?
  sku                 String                   @unique
  categoryId          Int
  category            Category                 @relation(fields: [categoryId], references: [id])
  subcategoryId       Int?
  subcategory         Subcategory?             @relation(fields: [subcategoryId], references: [id])
  brand               String?
  price               Decimal                  @default(0)
  currency            String                   @default("USD")
  listPrice           Decimal                  @default(0)
  salePrice           Decimal?
  saleStartsAt        DateTime?
  saleEndsAt          DateTime?
  priceUpdatedAt      DateTime                 @default(now())
  stockQuantity       Int                      @default(0)
  availableQuantity   Int                      @default(0)
  reservedQuantity    Int                      @default(0)
  inventoryStatus     InventoryStatus          @default(IN_STOCK)
  availabilityUpdatedAt DateTime               @default(now())
  isAvailable         Boolean                  @default(true)
  isActive            Boolean                  @default(true)
  popularityScore     Float                    @default(0)
  publishedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  attributes          ProductAttribute[]
  images              ProductImage[]
  specifications      ProductSpecification[]
  inventoryLevels     ProductInventoryLevel[]
  ratingAggregate     ProductRatingAggregate?
  relatedProductsFrom ProductRelationship[]     @relation("ProductRelationshipsFrom")
  relatedProductsTo   ProductRelationship[]     @relation("ProductRelationshipsTo")
  savedCartItems      SavedCartItem[]
  cartItems           CartItem[]

  @@index([categoryId, isActive, price])
  @@index([categoryId, isActive, createdAt])
  @@index([categoryId, isActive, popularityScore])
  @@index([brand])
  @@index([isActive, price])
  @@index([publishedAt])
  @@index([inventoryStatus])
  @@index([isAvailable, inventoryStatus])
  @@index([availableQuantity])
  @@index([reservedQuantity])
}

model Payment {
  id                Int                          @id @default(autoincrement())
  orderId           Int?
  cartId            Int?
  cart              Cart?                        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  checkoutSessionId Int?
  checkoutSession   CheckoutSession?             @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  userId            Int?
  user              User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status            PaymentStatus                @default(PENDING)
  amount            Decimal                      @default(0)
  currency          String                       @default("USD")
  gatewayReference  String?                      @unique
  paymentReference  String?                      @unique
  failureReason     String?
  metadata          Json?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  attempts           PaymentAttempt[]
  refunds            PaymentRefund[]
  statusHistory      PaymentStatusHistory[]

  @@index([orderId])
  @@index([cartId])
  @@index([checkoutSessionId])
  @@index([userId])
  @@index([gatewayReference])
  @@index([paymentReference])
}
