generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                        @id @default(autoincrement())
  email                   String                     @unique
  passwordHash            String
  emailVerified           Boolean                    @default(false)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  sessions                Session[]
  carts                   Cart[]
  orders                  Order[]
  savedPaymentPrefs       SavedPaymentPreference[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expiresAt    DateTime
  active       Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id])
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  items     String
  metadata  Json?
  createdAt DateTime @default(now())
}

model Order {
  id                          Int       @id @default(autoincrement())
  referenceId                 String    @unique
  userId                      Int?
  user                        User?     @relation(fields: [userId], references: [id])
  status                      OrderStatus
  paymentReference            String?
  paymentGatewayTransactionId String?
  paymentConfirmedAt          DateTime?
  finalizedAt                 DateTime?
  cancelledAt                 DateTime?
  cancellationReason          String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  payment                     Payment?
  orderLineItems              OrderLineItem[]
  shipments                   Shipment[]
  invoices                    Invoice[]

  @@index([status])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  FULFILLED
  CANCELLED
}

model Payment {
  id               Int          @id @default(autoincrement())
  orderId          Int          @unique
  cartId           Int?
  userId           Int?
  status           PaymentStatus
  amount           Decimal
  currency         String
  gatewayReference String
  paymentReference String
  metadata         Json?
  order            Order        @relation(fields: [orderId], references: [id])
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
}

model NotificationEventLog {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  type      String
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetToken {
  id          Int      @id @default(autoincrement())
  tokenHash   String   @unique
  userId      Int
  expiresAt   DateTime
  usedAt      DateTime?
  attemptedAt DateTime?
  attempts    Int?     @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model SavedPaymentPreference {
  id          Int      @id @default(autoincrement())
  userId      Int
  provider    String
  lastFour    String
  expiryMonth Int
  expiryYear  Int
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

/// =====================
/// Catalog management schema
/// =====================

/// Represents a product category; supports hierarchical nesting via parent/children
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  productCategory    Product[] @relation("ProductCategory")
  productSubcategory Product[] @relation("ProductSubcategory")
}

/// Represents a product in the catalog
model Product {
  id                   Int        @id @default(autoincrement())
  name                 String
  slug                 String     @unique
  description          String?
  brand                String?
  price                Decimal
  currency             String
  listPrice            Decimal?
  salePrice            Decimal?
  saleStartsAt         DateTime?
  saleEndsAt           DateTime?
  priceUpdatedAt       DateTime?
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // Inventory fields
  stockQuantity        Int        @default(0)
  availableQuantity    Int        @default(0)
  reservedQuantity     Int        @default(0)
  inventoryStatus      String?
  availabilityUpdatedAt DateTime?
  isAvailable          Boolean    @default(true)
  popularityScore      Int        @default(0)

  // Category relations (supports main & subcategory)
  categoryId           Int?
  category             Category?  @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategoryId        Int?
  subcategory          Category?  @relation("ProductSubcategory", fields: [subcategoryId], references: [id])

  images               ProductImage[]
}

/// Stores images and metadata for products
model ProductImage {
  id         Int      @id @default(autoincrement())
  productId  Int
  url        String
  altText    String?
  focalPoint Json?
  provider   String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// =====================
/// Coupons & Promotions schema
/// =====================
enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

enum TargetType {
  PRODUCT
  CATEGORY
}

model Promotion {
  id                Int                 @id @default(autoincrement())
  name              String
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal
  minPurchaseAmount Decimal?            @default(0)
  usageLimit        Int?
  usageCount        Int                 @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean             @default(true)
  metadata          Json?
  coupons           Coupon[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
}

model Coupon {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  description       String?
  discountType      CouponDiscountType
  discountValue     Decimal
  minPurchaseAmount Decimal?            @default(0)
  usageLimit        Int?
  usageCount        Int                 @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean             @default(true)
  metadata          Json?
  promotionId       Int?
  promotion         Promotion?          @relation(fields: [promotionId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([startsAt])
  @@index([expiresAt])
}

model PromotionTarget {
  id          Int        @id @default(autoincrement())
  promotionId Int
  targetType  TargetType
  targetId    Int
  createdAt   DateTime   @default(now())
  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([targetType, targetId])
}
