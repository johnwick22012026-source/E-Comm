generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommunicationChannel {
  EMAIL
  SMS
  PUSH
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
}

enum PaymentStatus {
  DRAFT
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  VOIDED
}

enum PaymentRefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum PaymentStatusHistorySource {
  INTERNAL
  GATEWAY
}

enum SavedCartRestoreStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum SavedCartItemRestoreStatus {
  PENDING
  RESTORED
  FAILED
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum CouponRedemptionStatus {
  PENDING
  APPLIED
  EXPIRED
  INVALIDATED
}

enum ShippingEstimateStatus {
  DRAFT
  CONFIRMED
  EXPIRED
}

enum CheckoutSessionStatus {
  DRAFT
  REVIEW
  PENDING_PAYMENT
  COMPLETED
  ABANDONED
}

enum PaymentAttemptStatus {
  PENDING
  AUTHORIZED
  FAILED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum AttributeDataType {
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
}

enum InventoryStatus {
  IN_STOCK
  BACKORDER
  PREORDER
  DISCONTINUED
}

enum RelatedProductType {
  ACCESSORY
  ALTERNATIVE
  COMPLEMENTARY
  SIMILAR
}

enum CartItemStatus {
  ACTIVE
  REMOVED
}

// === CUSTOMER PROFILE, ADDRESSES & PREFERENCES ===
model CustomerProfile {
  id           Int                       @id @default(autoincrement())
  userId       Int                       @unique
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String?                   
  lastName     String?                   
  phone        String?                   
  dateOfBirth  DateTime?                 
  addresses    Address[]                 
  preferences  CommunicationPreference[] 
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([userId])
}

enum CommunicationChannel {
  EMAIL
  SMS
  PUSH
}

model Address {
  id           Int             @id @default(autoincrement())
  profileId    Int
  profile      CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label        String?         // e.g. "Home", "Work"
  fullName     String
  company      String?
  streetLine1  String
  streetLine2  String?
  city         String
  state        String?
  postalCode   String
  country      String
  phone        String?
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([profileId])
}

enum CommunicationChannel {
  EMAIL
  SMS
  PUSH
}

model CommunicationPreference {
  id           Int                  @id @default(autoincrement())
  profileId    Int
  profile      CustomerProfile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  channel      CommunicationChannel
  preference   String               // e.g. "NEWSLETTER", "TRANSACTIONAL"
  enabled      Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([profileId, channel, preference])
  @@index([profileId])
}

// === EXISTING SCHEMA BELOW ===

model User {
  id              Int                      @id @default(autoincrement())
  email           String                   @unique
  passwordHash    String
  emailVerified   Boolean                  @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  customerProfile CustomerProfile?
  verificationTokens    EmailVerificationToken[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  savedCartSnapshots    SavedCartSnapshot[]
  couponRedemptions     CouponRedemption[]
  checkoutSessions      CheckoutSession[]
}

